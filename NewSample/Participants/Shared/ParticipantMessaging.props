<Project>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" Condition="'$(UsingMicrosoftNETSdkWeb)' != 'true'" />
    <PackageReference Include="RabbitMQ.Client" Version="7.2.2" />
    <Compile Include="$(MSBuildThisFileDirectory)Messaging/*.cs" Link="Messaging/Shared/%(Filename)%(Extension)" />
    <Compile Include="$(MSBuildThisFileDirectory)../../../samples/Participants/Shared/ParticipantProtocol.cs" Link="Messaging/Protocol/ParticipantProtocol.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../../../samples/Participants/Shared/ParticipantBinding.cs" Link="Messaging/Protocol/ParticipantBinding.cs" />
  </ItemGroup>
</Project>
