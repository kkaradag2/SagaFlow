<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Npgsql" Version="10.0.4" />
    <PackageReference Include="RabbitMQ.Client" Version="7.2.2" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <Using Include="Xunit" />
    <AssemblyMetadata Include="RepositoryRoot" Value="$(MSBuildProjectDirectory)/../.." />
    <AssemblyMetadata Include="BuildConfiguration" Value="$(Configuration)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../Sample/DomainStarters/*/*.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="../../Sample/Participants/*/*.csproj" ReferenceOutputAssembly="false" Private="false" />
    <Compile Include="../SagaFlow.Storage.PostgreSQL.Tests/PostgreSqlTestDatabase.cs" Link="PostgreSqlTestDatabase.cs" />
    <Compile Include="../../Sample/Participants/Shared/Protocol/*.cs" Link="ParticipantProtocol/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
