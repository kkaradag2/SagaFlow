<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SagaFlow.Hosting\SagaFlow.Hosting.csproj" />
    <ProjectReference Include="..\..\src\SagaFlow.Engine\SagaFlow.Engine.csproj" />
    <ProjectReference Include="..\..\src\SagaFlow.Core\SagaFlow.Core.csproj" />
    <ProjectReference Include="..\..\samples\SagaFlow.SimpleShopping\SagaFlow.SimpleShopping.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="CopyDiscoveryProcessFixture" AfterTargets="Build">
    <ItemGroup>
      <DiscoveryProcessFixture Include="$(MSBuildProjectDirectory)\..\..\samples\SagaFlow.SimpleShopping\bin\$(Configuration)\$(TargetFramework)\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(DiscoveryProcessFixture)" DestinationFiles="@(DiscoveryProcessFixture->'$(OutDir)DiscoveryProcessFixture\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
