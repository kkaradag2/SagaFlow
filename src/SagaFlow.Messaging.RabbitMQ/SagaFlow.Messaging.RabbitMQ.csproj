<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>RabbitMQ messaging transport for SagaFlow saga workflows.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.0" />
    <PackageReference Include="RabbitMQ.Client" Version="7.2.2" />
    <ProjectReference Include="..\SagaFlow.Core\SagaFlow.Core.csproj" />
    <ProjectReference Include="..\SagaFlow.Engine\SagaFlow.Engine.csproj" />
    <ProjectReference Include="..\SagaFlow.Hosting\SagaFlow.Hosting.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="SagaFlow.Messaging.RabbitMQ.Tests" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
