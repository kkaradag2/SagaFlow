<Project>
  <ItemGroup>
    <Content Include="$(MSBuildThisFileDirectory)..\tools\dashboard\**\*">
      <Link>wwwroot\dashboard\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
</Project>
