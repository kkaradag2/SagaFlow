{
  "RabbitMq": {
    "ConnectionString": "amqp://newsample:newsample-rabbitmq@127.0.0.1:5673/",
    "ClientProvidedName": "newsample-notification-python",
    "CommandExchange": "sagaflow.commands",
    "Queues": {
      "managerNotification": "NotifyManager",
      "notification": "SendOrderNotification",
      "acceptedNotification": "NotifyReturnAccepted",
      "rejectedNotification": "NotifyReturnRejected"
    },
    "OutcomeQueues": [ "order.outcomes", "return.outcomes" ]
  }
}
